# Local agent tooling: installed skills and the lock file that records where each
# one came from. Both are recreated by the skill manager on demand, and the lock
# file pins machine-local sources, so neither belongs in the repository.
.agents/
skills-lock.json

# Dependencies. The tool package keeps its own .gitignore for the rest.
node_modules/

# Editors and OS
.DS_Store
Thumbs.db
*.swp
*~

# Logs and scratch
*.log
npm-debug.log*
pnpm-debug.log*

# The sample pack is generated by scripts/make-sample-pack.py rather than committed.
dsh-plugin-emote-chat/samples/

# 本地宿主源码诊断与临时脚本
.scratch/
